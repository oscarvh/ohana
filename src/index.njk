---
layout: layouts/base.njk
title: Bienvenida
hideNav: true
---
<main class="relative flex flex-col items-center min-h-screen px-margin pt-safe pb-safe overflow-hidden">

  <!-- Elementos decorativos de fondo -->
  <div class="absolute inset-0 pointer-events-none overflow-hidden opacity-30">
    <div class="absolute -top-12 -left-12 w-64 h-64 rounded-full bg-primary-fixed/40 blur-3xl"></div>
    <div class="absolute top-1/2 -right-16 w-72 h-72 rounded-full bg-secondary-fixed/50 blur-3xl"></div>
  </div>

  <!-- Chip superior -->
  <div class="relative z-10 w-full flex justify-center mt-space-lg mb-space-md">
    <div class="inline-flex items-center gap-2 px-space-md py-1.5 rounded-full bg-secondary-fixed text-on-secondary-fixed-variant shadow-sm">
      <span class="material-symbols-outlined text-secondary text-[18px]" style="font-variation-settings: 'FILL' 1;">music_note</span>
      <span class="text-label-sm tracking-wide">Cancionero comunitario</span>
      <span class="w-1.5 h-1.5 rounded-full bg-secondary animate-pulse"></span>
    </div>
  </div>

  <!-- Identidad -->
  <div class="relative z-10 flex flex-col items-center max-w-sm mx-auto my-auto w-full text-center">
    <div class="relative flex items-center justify-center mb-space-lg">
      <div class="absolute -inset-2 rounded-full bg-surface-container-high/80 blur-md"></div>
      <div class="relative w-52 h-52 sm:w-60 sm:h-60 rounded-full p-2 bg-surface-container-lowest shadow-md flex items-center justify-center">
        <img src="{{ '/images/logo-ohana.png' | url }}" alt="Logo de la Orquesta Escuela Ohana de Punta Indio" class="w-full h-full object-contain rounded-full">
      </div>
      <div class="absolute bottom-2 right-2 w-10 h-10 rounded-full bg-primary text-on-primary flex items-center justify-center shadow-md">
        <span class="material-symbols-outlined text-[20px]">audiotrack</span>
      </div>
    </div>
    <h1 class="font-serif text-display-lg-mobile text-on-surface tracking-tight mb-space-xs font-semibold">Ohana</h1>
    <p class="text-title-lg text-primary tracking-normal font-medium mb-space-sm">Orquesta Escuela de Punta Indio</p>
    <div class="w-12 h-0.5 bg-secondary-fixed-dim rounded-full mb-space-md"></div>
    <p class="text-body-md text-on-surface-variant max-w-xs leading-relaxed px-space-xs">
      Música para compartir, crecer y cantar juntos en familia sobre la costa de nuestro río.
    </p>
  </div>

  <!-- CTA + datos comunitarios -->
  <div class="relative z-10 w-full max-w-xs mx-auto flex flex-col items-center gap-space-lg mt-space-lg mb-space-lg">
    <a href="{{ '/canciones/' | url }}" class="w-full h-14 rounded-2xl bg-primary text-on-primary text-title-lg flex items-center justify-between px-space-lg shadow-md transition-all duration-200 active:scale-95 active:bg-primary-container hover:shadow-lg focus:outline-none">
      <span class="flex items-center gap-3">
        <span class="material-symbols-outlined text-[24px] text-primary-fixed">menu_book</span>
        <span class="font-medium tracking-wide">Abrir Cancionero</span>
      </span>
      <span class="w-8 h-8 rounded-full bg-on-primary/15 flex items-center justify-center">
        <span class="material-symbols-outlined text-[20px]">arrow_forward</span>
      </span>
    </a>
    <div class="flex flex-col items-center gap-1.5">
      <div class="flex items-center gap-2 text-on-surface-variant text-label-md">
        <span class="material-symbols-outlined text-secondary text-[18px]" style="font-variation-settings: 'FILL' 1;">favorite</span>
        <span>Punta Indio • Comunidad &amp; Música</span>
      </div>
      <span class="text-label-sm text-outline">Edición Concierto 2025</span>
    </div>
  </div>
</main>
