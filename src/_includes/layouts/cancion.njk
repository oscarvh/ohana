---
layout: layouts/base.njk
---
<header class="fixed top-0 inset-x-0 z-50 bg-surface/90 backdrop-blur-xl shadow-[0_1px_12px_rgba(14,112,117,0.06)] pt-safe">
  <div class="h-16 px-margin flex items-center gap-2 max-w-2xl mx-auto">
    <a href="{{ '/canciones/' | url }}" aria-label="Volver" class="w-11 h-11 -ml-2 rounded-full flex items-center justify-center text-primary hover:bg-surface-container transition-colors active:scale-95">
      <span class="material-symbols-outlined text-[24px]">arrow_back</span>
    </a>
    <div class="flex flex-col min-w-0 flex-1">
      <h1 class="font-serif text-headline-md text-on-surface truncate">Atril de canción</h1>
      <span class="text-label-sm text-tertiary truncate font-medium">Orquesta Escuela de Punta Indio</span>
    </div>
    <button id="btn-share" type="button" aria-label="Compartir letra" class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary active:scale-95 transition-all shadow-sm">
      <span class="material-symbols-outlined text-[20px]">share</span>
    </button>
  </div>
</header>

<main class="w-full max-w-2xl mx-auto px-margin pt-20 pb-32 flex flex-col">
  <div class="flex flex-col w-full">

    <!-- Info rápida -->
    <div class="flex items-center justify-between gap-space-sm pt-space-xs pb-space-sm">
      <div class="flex items-center gap-space-xs min-w-0">
        {% if categoria %}
        <span class="inline-flex items-center px-2.5 py-1 rounded-full bg-secondary-fixed text-on-secondary-fixed text-label-sm shadow-sm">
          <span class="material-symbols-outlined text-[14px] mr-1">queue_music</span>{{ categoria }}
        </span>
        {% endif %}
        <span class="text-label-sm text-tertiary truncate font-medium">Cancionero</span>
      </div>
      <button id="btn-fav" type="button" aria-label="Guardar en favoritos" class="w-10 h-10 rounded-full bg-surface-container flex items-center justify-center text-primary active:scale-95 transition-all shadow-sm" data-url="{{ page.url | url }}">
        <span class="material-symbols-outlined text-[20px]" id="fav-icon">favorite</span>
      </button>
    </div>

    <!-- Cabecera de la canción -->
    <div class="w-full bg-surface-container-lowest rounded-2xl p-space-md shadow-sm mb-space-md relative overflow-hidden">
      <div class="absolute -top-12 -right-12 w-32 h-32 bg-secondary-fixed/40 rounded-full blur-2xl pointer-events-none"></div>
      <div class="absolute -bottom-8 -left-8 w-28 h-28 bg-primary-fixed/40 rounded-full blur-xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col gap-space-xs">
        <h2 class="font-serif text-headline-lg-mobile text-on-surface tracking-tight mt-1">{{ titulo }}</h2>
        {% if autor %}
        <p class="text-body-sm text-tertiary font-medium">{{ autor }}</p>
        {% endif %}
      </div>
    </div>

    <!-- Controles de lectura (ergonómicos) -->
    <div class="sticky top-16 z-30 py-space-xs mb-space-md bg-surface/95 backdrop-blur-md">
      <div class="w-full bg-surface-container-high rounded-full p-1.5 shadow-md flex items-center justify-between gap-2">
        <div class="flex items-center bg-surface-container-lowest rounded-full px-1 shadow-sm">
          <button id="font-decrease" type="button" aria-label="Reducir letra" class="w-9 h-9 rounded-full flex items-center justify-center text-primary text-title-lg active:scale-90 transition-transform">A-</button>
          <div class="w-px h-4 bg-surface-variant mx-1"></div>
          <button id="font-increase" type="button" aria-label="Aumentar letra" class="w-9 h-9 rounded-full flex items-center justify-center text-primary text-title-lg active:scale-90 transition-transform">A+</button>
        </div>
        <button id="btn-fullscreen" type="button" class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-surface-container text-outline text-label-md shadow-sm active:scale-95 transition-all">
          <span class="material-symbols-outlined text-[18px]" id="fullscreen-icon">fullscreen</span>
          <span id="fullscreen-status-text">Pantalla completa</span>
        </button>
      </div>
    </div>

    <!-- Letra -->
    <section class="bg-surface-container-lowest rounded-2xl p-space-md shadow-sm mb-space-md">
      <div id="lyrics-stream" class="text-body-lyrics text-on-surface [&_p]:mb-space-md [&_p:last-child]:mb-0">{{ content | safe }}</div>
    </section>
  </div>
</main>

<!-- Deck inferior: navegación entre canciones -->
<div class="fixed bottom-20 inset-x-4 z-40 max-w-lg mx-auto">
  <div class="bg-surface-container-lowest/95 backdrop-blur-xl p-2 rounded-2xl shadow-xl flex items-center gap-2">
    <button id="nav-prev" type="button" class="h-14 px-4 rounded-xl bg-surface-container text-primary text-label-md flex items-center justify-center gap-1 active:scale-95 transition-all">
      <span class="material-symbols-outlined text-[20px]">chevron_left</span>
    </button>
    <button id="nav-next" type="button" class="flex-1 h-14 rounded-xl bg-gradient-to-r from-primary-container to-secondary text-on-primary text-title-lg flex items-center justify-center gap-2 shadow-md active:scale-95 transition-all">
      <span>Siguiente canción</span>
      <span class="material-symbols-outlined text-[22px]">arrow_forward</span>
    </button>
    <a href="{{ '/canciones/' | url }}" aria-label="Volver al cancionero completo" class="w-14 h-14 rounded-xl bg-surface-container text-tertiary flex items-center justify-center active:scale-95 transition-all">
      <span class="material-symbols-outlined text-[24px]">library_music</span>
    </a>
  </div>
</div>

<script type="application/json" id="song-nav">[{% for c in collections.canciones %}{"titulo": {{ c.data.titulo | dump | safe }}, "url": {{ c.url | url | dump | safe }}}{% if not loop.last %}, {% endif %}{% endfor %}]</script>
<script src="{{ '/js/atril.js' | url }}" defer></script>
