<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#00565a">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/images/favicon-32.png' | url }}">
  <link rel="icon" type="image/png" sizes="192x192" href="{{ '/images/favicon-192.png' | url }}">
  <link rel="apple-touch-icon" href="{{ '/images/apple-touch-icon.png' | url }}">
  <title>{{ title or titulo or "Cancionero" }} · Ohana</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=add,arrow_back,arrow_forward,audiotrack,close,content_copy,delete,edit,favorite,fullscreen,fullscreen_exit,lyrics,menu_book,mobile_off,music_note,queue_music,save,screen_lock_portrait,search,search_off,share&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/assets/main.css' | url }}">
</head>
<body class="bg-surface font-sans text-body-md text-on-surface antialiased">
  {{ content | safe }}

  {% if not hideNav %}
  <nav id="nav-inferior" class="fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface-container-lowest/95 backdrop-blur-xl shadow-[0_-4px_20px_rgba(104,63,97,0.06)]" aria-label="Navegación principal">
    <div class="flex justify-around items-center h-16 px-margin">
      <a href="{{ '/canciones/' | url }}" class="flex flex-col items-center justify-center gap-1 w-16 h-12 text-primary font-semibold transition-colors" aria-current="page">
        <span class="material-symbols-outlined text-[24px]">queue_music</span>
        <span class="text-label-sm">Canciones</span>
      </a>
      <a href="{{ '/canciones/' | url }}#favoritos" class="flex flex-col items-center justify-center gap-1 w-16 h-12 text-on-surface-variant hover:text-primary transition-colors">
        <span class="material-symbols-outlined text-[24px]">favorite</span>
        <span class="text-label-sm">Favoritos</span>
      </a>
      <a href="{{ '/compartir/' | url }}" class="flex flex-col items-center justify-center gap-1 w-16 h-12 text-on-surface-variant hover:text-primary transition-colors">
        <span class="material-symbols-outlined text-[24px]">share</span>
        <span class="text-label-sm">Compartir</span>
      </a>
    </div>
  </nav>
  {% endif %}
</body>
</html>
