<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#00565a">
  <title>{{ title or titulo or "Cancionero" }} · Ohana</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/@tailwindcss/browser@4"></script>
  <style type="text/tailwindcss">
    @theme {
      --font-sans: "Plus Jakarta Sans", ui-sans-serif, system-ui, sans-serif;
      --font-serif: "Playfair Display", ui-serif, Georgia, serif;

      --color-surface: #fbf9f5;
      --color-surface-dim: #dbdad6;
      --color-surface-bright: #fbf9f5;
      --color-surface-container-lowest: #ffffff;
      --color-surface-container-low: #f5f3ef;
      --color-surface-container: #efeeea;
      --color-surface-container-high: #eae8e4;
      --color-surface-container-highest: #e4e2de;
      --color-surface-variant: #e4e2de;
      --color-on-surface: #1b1c1a;
      --color-on-surface-variant: #3e4949;
      --color-inverse-surface: #30312e;
      --color-inverse-on-surface: #f2f0ed;
      --color-outline: #6e797a;
      --color-outline-variant: #bec9c9;
      --color-surface-tint: #00696e;
      --color-background: #fbf9f5;
      --color-on-background: #1b1c1a;

      --color-primary: #00565a;
      --color-on-primary: #ffffff;
      --color-primary-container: #0e7075;
      --color-on-primary-container: #a0f0f6;
      --color-inverse-primary: #83d3d9;
      --color-primary-fixed: #a0f0f5;
      --color-primary-fixed-dim: #83d3d9;
      --color-on-primary-fixed: #002022;
      --color-on-primary-fixed-variant: #004f53;

      --color-secondary: #a33d23;
      --color-on-secondary: #ffffff;
      --color-secondary-container: #ff8162;
      --color-on-secondary-container: #731a04;
      --color-secondary-fixed: #ffdad2;
      --color-secondary-fixed-dim: #ffb4a2;
      --color-on-secondary-fixed: #3c0700;
      --color-on-secondary-fixed-variant: #83260e;

      --color-tertiary: #683f61;
      --color-on-tertiary: #ffffff;
      --color-tertiary-container: #82577a;
      --color-on-tertiary-container: #ffd8f4;
      --color-tertiary-fixed: #ffd7f4;
      --color-tertiary-fixed-dim: #ebb7df;
      --color-on-tertiary-fixed: #300e2d;
      --color-on-tertiary-fixed-variant: #61395b;

      --color-error: #ba1a1a;
      --color-on-error: #ffffff;
      --color-error-container: #ffdad6;
      --color-on-error-container: #93000a;

      --text-display-lg: 2.5rem;
      --text-display-lg--line-height: 3rem;
      --text-display-lg-mobile: 2rem;
      --text-display-lg-mobile--line-height: 2.5rem;
      --text-headline-lg: 2rem;
      --text-headline-lg--line-height: 2.5rem;
      --text-headline-lg-mobile: 1.625rem;
      --text-headline-lg-mobile--line-height: 2.125rem;
      --text-headline-md: 1.375rem;
      --text-headline-md--line-height: 1.75rem;
      --text-title-lg: 1.125rem;
      --text-title-lg--line-height: 1.625rem;
      --text-body-lyrics: 1.125rem;
      --text-body-lyrics--line-height: 2rem;
      --text-body-md: 1rem;
      --text-body-md--line-height: 1.6rem;
      --text-body-sm: 0.875rem;
      --text-body-sm--line-height: 1.375rem;
      --text-label-md: 0.875rem;
      --text-label-md--line-height: 1.25rem;
      --text-label-sm: 0.75rem;
      --text-label-sm--line-height: 1rem;

      --spacing-margin: 1rem;
      --spacing-gutter: 1rem;
      --spacing-space-xs: 0.25rem;
      --spacing-space-sm: 0.5rem;
      --spacing-space-md: 1rem;
      --spacing-space-lg: 1.5rem;
      --spacing-space-xl: 2.25rem;
      --spacing-space-2xl: 3rem;
    }

    @layer base {
      html, body { width: 100%; margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
      .pb-safe { padding-bottom: env(safe-area-inset-bottom, 0px); }
      .pt-safe { padding-top: env(safe-area-inset-top, 0px); }
      ::-webkit-scrollbar { display: none; }
    }
  </style>
</head>
<body class="bg-surface font-sans text-body-md text-on-surface antialiased">
  {{ content | safe }}

  {% if not hideNav %}
  <nav class="fixed bottom-0 inset-x-0 z-50 pb-safe bg-surface-container-lowest/95 backdrop-blur-xl shadow-[0_-4px_20px_rgba(104,63,97,0.06)]" aria-label="Navegación principal">
    <div class="flex justify-around items-center h-16 px-margin">
      <a href="{{ '/canciones/' | url }}" class="flex flex-col items-center justify-center gap-1 w-16 h-12 text-primary font-semibold transition-colors" aria-current="page">
        <span class="material-symbols-outlined text-[24px]">queue_music</span>
        <span class="text-label-sm">Canciones</span>
      </a>
      <a href="{{ '/canciones/' | url }}#favoritos" class="flex flex-col items-center justify-center gap-1 w-16 h-12 text-on-surface-variant hover:text-primary transition-colors">
        <span class="material-symbols-outlined text-[24px]">favorite</span>
        <span class="text-label-sm">Favoritos</span>
      </a>
      <a href="{{ '/compartir/' | url }}" class="flex flex-col items-center justify-center gap-1 w-16 h-12 text-on-surface-variant hover:text-primary transition-colors">
        <span class="material-symbols-outlined text-[24px]">share</span>
        <span class="text-label-sm">Compartir</span>
      </a>
    </div>
  </nav>
  {% endif %}
</body>
</html>
