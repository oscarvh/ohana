---
layout: layouts/base.njk
title: Compartir
permalink: /compartir/
---
<main class="w-full max-w-2xl mx-auto px-margin pt-safe pb-24 flex flex-col gap-space-lg">

  <header class="flex items-center gap-space-sm pt-space-md">
    <a href="{{ '/canciones/' | url }}" aria-label="Volver" class="w-11 h-11 -ml-2 rounded-full flex items-center justify-center text-primary hover:bg-surface-container transition-colors active:scale-95">
      <span class="material-symbols-outlined text-[24px]">arrow_back</span>
    </a>
    <h1 class="font-serif text-headline-md text-on-surface">Compartir el cancionero</h1>
  </header>

  <section class="bg-surface-container-lowest rounded-2xl p-space-lg shadow-sm flex flex-col items-center gap-space-md text-center">
    <div class="w-12 h-12 rounded-full bg-primary-fixed/40 flex items-center justify-center text-primary">
      <span class="material-symbols-outlined text-[26px]">share</span>
    </div>
    <h2 class="font-serif text-headline-md text-primary tracking-tight">Invitá a la familia a cantar</h2>
    <p class="text-body-sm text-on-surface-variant max-w-xs">
      Mostrale este código QR a un familiar para que escanee con la cámara del celular,
      o pasale el enlace de abajo.
    </p>

    <img src="{{ '/images/qr-ohana.png' | url }}" alt="Código QR del Cancionero Ohana" class="w-56 h-56 rounded-2xl shadow-md bg-surface-container-lowest">

    <p id="enlace-texto" class="text-body-sm text-primary font-semibold select-all">https://oscarvh.github.io/ohana/</p>

    <div class="flex items-center justify-center gap-space-sm w-full">
      <button id="btn-copiar" type="button"
        class="flex-1 flex items-center justify-center gap-1.5 rounded-full bg-surface-container text-primary font-semibold py-3 px-4 text-label-md shadow-sm active:scale-95 transition-all">
        <span class="material-symbols-outlined text-[20px]">content_copy</span>
        Copiar
      </button>
      <button id="btn-compartir" type="button"
        class="flex-1 flex items-center justify-center gap-1.5 rounded-full bg-primary text-on-primary font-semibold py-3 px-4 text-label-md shadow-sm active:scale-95 transition-all">
        <span class="material-symbols-outlined text-[20px]">share</span>
        Compartir
      </button>
      <a id="btn-whatsapp" href="#" target="_blank" rel="noopener" aria-label="Compartir por WhatsApp"
        class="shrink-0 w-12 h-12 rounded-full flex items-center justify-center text-white shadow-sm active:scale-95 transition-all"
        style="background-color:#25D366">
        <svg viewBox="0 0 24 24" class="w-6 h-6 fill-current" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.297.347-.495.115-.198.058-.371-.058-.52-.115-.148-.694-1.673-1.037-2.293-.23-.42-.5-.435-.736-.443-.184-.008-.395-.008-.606-.008-.212 0-.556.08-.847.397-.29.297-1.11 1.086-1.11 2.645 0 1.558 1.136 3.064 1.295 3.278.153.214 2.228 3.402 5.396 4.774.754.326 1.343.52 1.8.666.758.242 1.448.208 2.002.126.608-.091 1.87-.764 2.132-1.502.262-.737.262-1.37.184-1.502-.077-.131-.28-.213-.577-.362z"/>
          <path d="M20.52 3.449C18.24 1.245 15.24 1.023 14.986 1.006a.964.964 0 0 0-.112-.005H9.014c-4.65 0-8.437 3.787-8.437 8.437v5.126c0 4.65 3.787 8.437 8.437 8.437h5.126c4.65 0 8.437-3.787 8.437-8.437V9.436l.005-.088a.964.964 0 0 0-.005-.112c-.017-.254-.24-3.254-2.458-5.532l-.099-.104zM12 21.42a9.42 9.42 0 0 1-9.42-9.42 9.42 9.42 0 0 1 9.42-9.42h2.874c.285.014 2.588.212 4.323 1.945 1.735 1.735 1.933 4.04 1.947 4.325v5.15a9.42 9.42 0 0 1-9.42 9.42z" fill-rule="evenodd"/>
        </svg>
      </a>
    </div>

    <p id="mensaje-copiado" class="hidden text-label-md text-secondary font-semibold">Enlace copiado ✔</p>
  </section>

  <footer class="text-center flex flex-col items-center gap-1">
    <div class="flex items-center justify-center gap-1.5 text-secondary">
      <span class="material-symbols-outlined text-[18px]">favorite</span>
      <span class="text-label-sm font-semibold tracking-wider uppercase">Orquesta Escuela de Punta Indio</span>
      <span class="material-symbols-outlined text-[18px]">favorite</span>
    </div>
    <p class="text-body-sm text-on-surface-variant italic">"Música para compartir, crecer y sentirnos en casa"</p>
  </footer>
</main>

<script>
  (function () {
    var ENLACE = "https://oscarvh.github.io/ohana/";
    var btnCopiar = document.getElementById("btn-copiar");
    var btnCompartir = document.getElementById("btn-compartir");
    var aviso = document.getElementById("mensaje-copiado");
    function mostrarAviso() {
      aviso.classList.remove("hidden");
      clearTimeout(aviso._t);
      aviso._t = setTimeout(function () { aviso.classList.add("hidden"); }, 3000);
    }
    btnCopiar.addEventListener("click", function () {
      navigator.clipboard.writeText(ENLACE).then(mostrarAviso).catch(function () {});
    });
    btnCompartir.addEventListener("click", function () {
      if (navigator.share) {
        navigator.share({ title: "Cancionero Ohana", text: TEXTO, url: ENLACE }).catch(function () {});
      } else {
        navigator.clipboard.writeText(ENLACE).then(function () { mostrarAviso(); }).catch(function () {});
      }
    });
    var TEXTO = "Cancionero Ohana — Orquesta Escuela de Punta Indio 🎶\n" + ENLACE;
    document.getElementById("btn-whatsapp").href = "https://wa.me/?text=" + encodeURIComponent(TEXTO);
  })();
</script>
